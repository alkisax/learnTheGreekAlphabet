{
  "expo": {
    "name": "nativeLearnTheGreekAlphabet",
    "slug": "nativeLearnTheGreekAlphabet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nativelearnthegreekalphabet",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/expo.icon"
    },

    "android": {
      "package": "com.alkisax.learngreekalphabet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFDF4"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4041382605494077~1465843060"
        }
      ],

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
